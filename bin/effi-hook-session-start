#!/usr/bin/env bash
# effi-hook-session-start — Claude Code SessionStart hook (v4.7, Layer 3).
#
# This is where the launch screen shows up. Claude Code clears the terminal when
# it starts, so anything `effi` prints before exec'ing it is gone before the
# user can read it — the screen has to come from inside the session.
#
# Channels are NOT interchangeable (verified against the CLI's renderer):
#   systemMessage            → displayed to the user ("<hook> says: …")
#   hookSpecificOutput.additionalContext → added to Claude's context, not shown
#   plain stdout             → context too, but as a *meta* attachment the user
#                              never sees. Do not use it for the screen.
# So this hook replies with JSON: panel + connect guidance to the user, compact
# preflight + onboarding instructions to the model.
#
# By source: startup / clear / fork → full screen; resume / compact → one line.
#
# Env: EFFI_SPLASH_WIDTH (default 72 — fits Claude Code's transcript gutter)
#      EFFI_SPLASH_ART=0 drops the wordmark
#      EFFI_NO_SPLASH=1  collapses the screen to the one-liner
#
# Wire: "hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"<this>"}]}]}
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"

# Claude Code delivers the event payload as JSON on stdin. When a human runs
# this by hand there's no payload — don't block on a terminal read.
PAYLOAD=""
if [ ! -t 0 ]; then PAYLOAD="$(cat || true)"; fi

# stdout must be *only* JSON: the CLI treats output that doesn't start with `{`
# as plain text and drops the JSON fields entirely.
EFFI_HOOK_PAYLOAD="$PAYLOAD" python3 - <<'PY'
import json
import os

try:
    from effi_core import hook_session_start_output

    try:
        payload = json.loads(os.environ.get("EFFI_HOOK_PAYLOAD") or "{}") or {}
    except Exception:
        payload = {}

    width = os.environ.get("EFFI_SPLASH_WIDTH") or ""
    out = hook_session_start_output(
        source=payload.get("source") or "startup",
        width=int(width) if width.isdigit() else 72,
        wordmark=os.environ.get("EFFI_SPLASH_ART", "1") != "0",
        muted=os.environ.get("EFFI_NO_SPLASH") == "1",
    )
except Exception as e:
    # A hook that raises would take the session's start banner with it —
    # degrade to one honest line the user can actually see.
    out = {"systemMessage": f"effi preflight unavailable: {e}"}

print(json.dumps(out, ensure_ascii=False))
PY
