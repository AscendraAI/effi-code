#!/usr/bin/env bash
# effi-hook-session-start — Claude Code SessionStart hook (v4.5, Layer 3).
# Emits a provider preflight summary as session context so the user sees which
# providers are connected + a mode recommendation at the top of every session.
#
# Wire: "hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"<this>"}]}]}
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
python3 - <<'PY'
# For SessionStart, plain stdout on exit 0 is added to the session context —
# simpler and unambiguous vs guessing the JSON shape (and avoids double-inject).
try:
    from effi_core import connect_report, format_connect, format_preflight, project_mode_is_set
    rep = connect_report(probe=False)
    # Unpinned project = not yet onboarded → full welcome: intro + how-to-connect
    # + an [effi:action] block asking the assistant to explain, help connect any
    # missing providers, then ask the task and set the mode. Once pinned, this
    # collapses to the compact preflight table (no re-onboarding every session).
    if not project_mode_is_set():
        print(format_connect(rep, intro=True, action=True))
    else:
        print(format_preflight(rep))
except Exception as e:
    print(f"effi preflight unavailable: {e}")
PY
