#!/usr/bin/env bash
# effi-hook-prompt — Claude Code UserPromptSubmit hook (v4.5, Layer 3).
# Runs the mode nudge: if the prompt's task importance doesn't fit the active
# mode (throttled to once / 5 turns per session), injects a switch suggestion.
# Silent otherwise. Never blocks the prompt.
#
# Wire: "hooks":{"UserPromptSubmit":[{"hooks":[{"type":"command","command":"<this>"}]}]}
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"

# Capture the CC payload before the heredoc claims stdin (see effi-statusline).
if [ -t 0 ]; then RAW=""; else RAW="$(cat)"; fi

RAW="$RAW" python3 - <<'PY'
import os, json
raw = os.environ.get("RAW", "")
try:
    payload = json.loads(raw) if raw.strip() else {}
except Exception:
    payload = {}
prompt = payload.get("user_input") or payload.get("prompt") or ""
sess = payload.get("session_id")
line = ""
try:
    from effi_core import nudge, format_nudge
    line = format_nudge(nudge(prompt, session=sess))
except Exception:
    line = ""
# For UserPromptSubmit, plain stdout on exit 0 is added to context. Print the
# nudge line if any; stay silent (and never exit 2 / block the prompt) otherwise.
if line:
    print(line)
PY
